# ==============================================================================
# StudyVault - Environment Variables Configuration
# ==============================================================================

# 1. Admin Identity (Required)
# Enter the exact Google account email address that owns this website.
# Only this email will be allowed to log in as administrator.
ADMIN_EMAIL=your-google-email@gmail.com

# 2. Session Security (Required)
# Random 32+ character string used to sign secure session tokens.
# Generate one or use any long random passphrase.
SESSION_SECRET=change-this-to-a-very-long-random-secret-key-32-chars

# 3. Admin Master Password (Optional Fallback)
# Set a master password so you can also log in instantly from the Admin Login modal
# without needing Google OAuth setup in local development.
ADMIN_PASSWORD=your-secure-admin-password

# 4. Google Drive Folder ID (Required for uploads/deletes)
# The ID of your public study folder in Google Drive.
DRIVE_FOLDER_ID=1awA5Bnw1pleg3yr3TK7uPY7vsuYvQh9F

# 5. Google Drive Integration (Choose Option A or Option B):
# ---------------------------------------------------------
# Option A: Google Service Account Key (Recommended for automated direct uploads/deletes)
# Create a Service Account in Google Cloud Console, download the JSON key,
# and paste either the entire JSON content or base64 string here.
# Share your Drive folder (1awA5Bnw1pleg3yr3TK7uPY7vsuYvQh9F) with the Service Account email as Editor.
GOOGLE_SERVICE_ACCOUNT_KEY=

# Option B: Google Apps Script Web App (Alternative lightweight micro-backend)
# If using a Google Apps Script web app instead of service account.
GOOGLE_APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# 6. JSONBin.io Cloud Database (Already configured)
JSONBIN_BIN_ID=6ab8cfdcac6210605afa3737
JSONBIN_ACCESS_KEY=$2a$10$gVoGDRCKPS7u2SD/L1OKdOFcuIOHHnZF5BsJMLcKaTsUp.YJi2SRy

# 7. Google OAuth Client ID (Optional for one-tap Google Sign-In button)
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID (Web Application)
# Add your localhost and Vercel domains to "Authorized JavaScript origins".
VITE_GOOGLE_CLIENT_ID=
